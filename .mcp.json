{
    "mcpServers": {
        "shadcnVue": {
            "command": "npx",
            "args": ["shadcn-vue@latest", "mcp"]
        },
        "sequential-thinking": {
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
            "enabled": true
        },
        "laravel-boost": {
            "command": "./scripts/dev.sh",
            "args": ["artisan", "boost:mcp"],
            "enabled": false
        }
    }
}
