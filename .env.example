LOCAL_PROD_HTTPS_PORT=8443
LOCAL_PROD_HTTP3_PORT=8443
VITE_PORT=5173
MAILPIT_HTTP_PORT=8026

# Database Configuration (Docker Development)
CACHE_STORE=redis
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=asia
DB_USERNAME=swinx
DB_PASSWORD=swinx
DB_ROOT_PASSWORD=root
DB_ROOT_HOST=%
DB_APP_USERNAME=swinx
DB_APP_PASSWORD=swinx
BACKUP_RETENTION_DAYS=14


# Test Database Configuration
DB_TEST_CONNECTION=mariadb
DB_TEST_HOST=db
DB_TEST_PORT=3306
DB_TEST_DATABASE=db_test
DB_TEST_USERNAME=swinx
DB_TEST_PASSWORD=swinx

# Redis Configuration (Docker Development)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1
REDIS_CACHE_DB=1

# Cache & Session (Development)
CACHE_DRIVER=redis
CACHE_PREFIX=cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue (Development)
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Logging (Development)
LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Broadcasting
BROADCAST_CONNECTION=ably

# Generic Broadcaster Configuration (for Echo)
VITE_BROADCASTER=${BROADCAST_CONNECTION}
# Keep this as a literal value. Docker Compose warns on same-file variable expansion.
VITE_BROADCAST_KEY=KEY

# Ably Configuration
ABLY_KEY=KEY

# Laravel Echo Server Variables
VITE_ECHO_HOST=localhost
VITE_ECHO_PORT=6001
VITE_ECHO_PROTOCOL=http

# Mail (Development)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="system@asia-vn.edu.vn"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem (Development)
FILESYSTEM_DISK=local

# Development Tools
TELESCOPE_ENABLED=true
DEBUGBAR_ENABLED=false
VITE_DEV_SERVER_KEY=
VITE_DEV_SERVER_CERT=

# Development Security (Less Strict)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080
SESSION_SECURE_COOKIE=false

# FrankenPHP Configuration (Development)
FRANKENPHP_NUM_THREADS=auto
SERVER_NAME=localhost
LOCAL_PROD_SERVER_NAME=swinx.test
ACME_EMAIL=
RUN_MIGRATIONS=false
QUEUE_WORKER_QUEUES=default,emails,notifications,webhooks,reconciliation
QUEUE_WORKER_SLEEP=1
QUEUE_WORKER_TRIES=3

GOOGLE_APPLICATION_CREDENTIALS=storage/xenon-point-407303-ecde80c848d2.json
GOOGLE_DRIVE_FOLDER_ID_EVENT=example
GOOGLE_DRIVE_FOLDER_ID_QUERY=example
