# For local development with docker-compose

# Application
APP_NAME="Asia University"
VITE_APP_NAME="Asia University"
VITE_APP_URL_FE="http://localhost:3000"
VITE_APP_URL_FE_LECTURE="http://localhost:3001"
APP_ENV=local
APP_KEY=base64:9NX5UrRAaSObXu3roUfs7g8SF70SNt1TQfdck24f8Mk=
