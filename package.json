        "docker:down": "./scripts/dev.sh stop",
        "docker:logs": "./scripts/dev.sh logs",
        "docker:status": "./scripts/dev.sh status",
        "docker:test": "docker-compose -f docker-compose.yml -f docker-compose.test.yml up -d",
        "docker:test:down": "docker-compose -f docker-compose.yml -f docker-compose.test.yml down -v",
        "type-check": "vue-tsc --noEmit"
