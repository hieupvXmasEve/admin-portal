        "@tanstack/vue-table": "^8.21.3",
        "@vee-validate/zod": "^4.15.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/server-renderer": "^3.5.17",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "date-fns": "^4.1.0",
        "laravel-vite-plugin": "^1.0",
