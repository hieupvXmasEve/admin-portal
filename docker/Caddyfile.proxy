# ===========================================
# FrankenPHP — behind reverse proxy (Cloudflare / aaPanel nginx)
# ===========================================
# Expose container port 80 only. TLS terminates at Cloudflare or host nginx.
# Laravel routes (including /.well-known/* for MCP OAuth) are handled by php_server.

{
	frankenphp {
		num_threads {env.FRANKENPHP_NUM_THREADS}
	}

	auto_https off

	log {
		level INFO
		output stdout
	}
}

:80 {
	root * /app/public
	encode zstd br gzip

	header {
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	php_server {
		root /app/public
		split .php
	}

	@static {
		file
		path *.css *.js *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot *.map
	}
	header @static {
		Cache-Control "public, max-age=31536000, immutable"
	}

	respond /health "healthy" 200

	@sensitive {
		path /.env* /.git* /composer.* /package.* /webpack.* /.docker* /Dockerfile* /docker-compose.* /storage/logs/* /storage/framework/*
	}
	respond @sensitive 404
}