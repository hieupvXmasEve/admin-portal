                                    </a>
                                    <span v-else class="text-muted-foreground">-</span>
                                </td>
                                <td class="py-2">
                                    <div class="flex items-center gap-2">
                                        <Link :href="studentRoutes.studentDecisionsShow(decision.id)">
                                            <Button size="sm" variant="outline">
                                                <Eye class="mr-1 h-3 w-3" />
                                                View
                                            </Button>
