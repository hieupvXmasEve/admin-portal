    canAssign: boolean;
}

const props = defineProps<Props>();

const statusLabelMap: Record<string, string> = {
    open: 'Open',
    pending: 'Pending',
    answered: 'Answered',
    closed: 'Closed',
};

const statusVariantMap: Record<string, 'secondary' | 'outline' | 'default' | 'destructive'> = {
    open: 'secondary',
    pending: 'outline',
    answered: 'default',
    closed: 'destructive',
};

// Forms
const assignForm = useForm({
    assigned_to_user_id: props.ticket.assigned_to_user_id?.toString() || 'none',
    note: ''
});

const replyForm = useForm({
    message: '',
    is_official_answer: true,
    set_pending: false,
    attachment: null as File | null
});

// Computed
const replies = computed(() => props.ticket.query_ticket?.replies || []);
const isClosed = computed(() => props.ticket.query_status === 'closed');
const auditHistory = computed(() => props.ticket.assignments || []);

// Methods
const formatDate = (date: string) => format(new Date(date), 'dd/MM/yyyy HH:mm');
const formatRelative = (date: string) => formatDistanceToNow(new Date(date), { addSuffix: true });

const onAssign = () => {
    assignForm.post(route('forms.admin.inbox.assign', props.ticket.id), { 
        preserveScroll: true,
        onSuccess: () => {
            toast.success('Assignment updated successfully');
            assignForm.note = '';
        },
        onError: () => toast.error('Failed to update assignment')
    });
};

const onUpdateStatus = (val: string) => {
    router.post(route('forms.admin.inbox.status.update', props.ticket.id), 
        { status: val }, 
        { 
            preserveScroll: true,
            onSuccess: () => toast.success(`Status updated to ${val}`),
            onError: () => toast.error('Failed to update status')
        }
    );
};

const onFileChange = (e: Event) => {
    const files = (e.target as HTMLInputElement).files;
    if (files && files.length > 0) replyForm.attachment = files[0];
};

const onReply = () => {
    replyForm.post(route('forms.admin.inbox.reply', props.ticket.id), {
        preserveScroll: true,
        onSuccess: () => {
            toast.success('Reply posted successfully');
            replyForm.reset();
            const input = document.getElementById('reply-attachment') as HTMLInputElement;
            if (input) input.value = '';
        },
        onError: () => toast.error('Failed to post reply')
    });
};

const getActionBadge = (action: string) => {
    switch (action) {
        case 'assign': return 'default';
        case 'reassign': return 'outline';
        case 'unassign': return 'destructive';
        default: return 'secondary';
    }
};
</script>

