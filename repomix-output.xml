    const seasonMap: Record<string, string> = {
        SP: 'Spring',
        SUM: 'Summer',
        FAL: 'Fall',
        INT: 'Intersession',
    };

    const seasonName = seasonMap[season] || season;
    return `Academic Year ${year} - ${seasonName}`;
};
</script>

