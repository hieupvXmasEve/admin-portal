                </DialogHeader>
                <DialogFooter>
                    <Button variant="outline" @click="showRemoveDialog = false">Cancel</Button>
                    <Button variant="destructive" @click="removeParticipants" :disabled="loading"> Remove Participants </Button>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </div>
</template>
