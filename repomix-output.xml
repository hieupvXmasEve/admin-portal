                                                }
                                            }
                                        "
                                    >
                                        <SelectTrigger>
                                            <SelectValue placeholder="Select operator" />
                                        </SelectTrigger>
                                        <SelectContent>
                                            <SelectItem value="all">All Scores</SelectItem>
                                            <SelectItem value="gt">Greater than (&gt;)</SelectItem>
                                            <SelectItem value="gte">Greater than or equal (≥)</SelectItem>
