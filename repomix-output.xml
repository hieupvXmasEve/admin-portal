/**
 * Generate a code from a name by:
 * - Converting to uppercase
 * - Removing Vietnamese diacritics
 * - Replacing spaces with underscores
 * - Keeping only alphanumeric, hyphens, and underscores
 * @param name - The name to convert
 * @returns The generated code
 */
export function generateCodeFromName(name: string): string {
    if (!name) return '';

    return removeVietnameseDiacritics(name)
        .toUpperCase()
        .trim()
        .replace(/\s+/g, '_') // Replace spaces with underscores
        .replace(/[^A-Z0-9_-]/g, '') // Remove any character that's not alphanumeric, hyphen, or underscore
        .replace(/_+/g, '_') // Replace multiple underscores with single
        .replace(/^_|_$/g, ''); // Remove leading/trailing underscores
}

/**
 * Capitalize the first letter of each word in a string
 * @param str - The string to capitalize
 * @returns The string with first letter of each word capitalized
 */
export function capitalizeFirst(str: string | null | undefined): string {
    if (!str) return '';

    return str
        .toLowerCase()
        .split(' ')
        .map((word) => {
            if (!word) return '';
            return word.charAt(0).toUpperCase() + word.slice(1);
        })
        .join(' ');
}
