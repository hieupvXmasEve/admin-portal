            </CardHeader>
            <CardContent>
                <div class="mb-3 flex gap-4 text-sm">
                    <span>Total linked actions: <b>{{ selectedDecision.total_linked_actions ?? 0 }}</b></span>
                    <span>Total linked students: <b>{{ selectedDecision.total_linked_students ?? 0 }}</b></span>
