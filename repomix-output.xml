                    'message' => "{$student['student_name']} hasn't attended {$student['course_code']} for {$student['days_since_attendance']} days",
                    'created_at' => now()->toISOString(),
                ];
            }

            return collect($alerts)->sortByDesc('priority')->values()->toArray();
        });
    }

