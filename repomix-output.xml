            </CardHeader>
            <CardContent>
                <div class="flex flex-wrap items-center gap-4">
                    <!-- Search -->
                    <div class="min-w-[200px] flex-1">
                        <DebouncedInput placeholder="Search sessions..." v-model="filters.search" @debounced="handleSearch" />
                    </div>

                    <!-- Status Filter -->
                    <Select
