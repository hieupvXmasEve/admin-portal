                    <p class="text-muted-foreground">
                        {{ getTimeAgo(row.original.registered_at) }}
                    </p>
                </div>
            </template>

            <!-- Check-in Time Column -->
            <template #cell-checkin_time="{ row }">
                <div v-if="row.original.checkin_time" class="text-sm">
