            'change_reason' => 'Initial membership approval and role assignment',
            'started_at' => fake()->dateTimeBetween('-2 years', '-18 months'),
            'ended_at' => fake()->dateTimeBetween('-15 months', '-12 months'),
        ]);
    }
}
