	# Laravel storage symlink handling
	@storage {
		path /storage/*
	}
	rewrite @storage /storage{path}
	
	# Deny access to sensitive files
	@sensitive {
		path /.env* /.git* /composer.* /package.* /webpack.* /.docker* /Dockerfile* /docker-compose.*
	}
	respond @sensitive 404
	
	# Development logging
	log {
		output stdout
		format console
		level DEBUG
	}
}
