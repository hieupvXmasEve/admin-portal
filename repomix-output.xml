                </Button>
            </div>
        </div>

        <!-- Statistics Cards (shown when semester is selected) -->
        <div v-if="statistics" class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-5">
            <Card>
                <CardHeader class="pb-2">
