                            'name' => $cu->unit->name,
                            'credit_points' => $cu->unit->credit_points,
                            'prerequisite_groups' => $cu->unit->prerequisiteGroups->map(function ($group) {
                                return [
                                    'logic_operator' => $group->logic_operator,
