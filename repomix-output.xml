                        <FormField v-slot="{ componentField }" name="max_capacity">
                            <FormItem>
                                <FormLabel>Max Capacity *</FormLabel>
                                <FormControl>
                                    <NumberInput
                                        :model-value="componentField.modelValue"
                                        @update:model-value="componentField['onUpdate:modelValue']"
                                        :min="1"
