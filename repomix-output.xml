                                    :format-options="{ minimumFractionDigits: 0, maximumFractionDigits: 2 }">
                                    <NumberFieldContent>
                                        <NumberFieldInput />
                                    </NumberFieldContent>
                                </NumberField>
                            </FormControl>
                            <FormMessage />
