                                            (value) => {
                                                if (value && typeof value === 'string') {
                                                    overallFilterOperator = value as 'all' | 'gt' | 'gte' | 'lt' | 'lte' | 'eq';
                                                    if (value === 'all') {
                                                        overallFilterValue = undefined;
                                                        onOverallFilterChange('all', undefined);
