                        {{ form.type }}
                    </Badge>
                </div>
                <Badge variant="default">
                    {{ form.status }}
                </Badge>
            </div>
            <CardTitle class="mt-3">{{ form.title }}</CardTitle>
            <CardDescription v-if="form.description">
                {{ form.description }}
