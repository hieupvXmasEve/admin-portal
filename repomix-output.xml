    {
        // Building types and prefixes
        $buildingTypes = [
            'Academic' => ['A', 'ACAD', 'EDU'],
            'Science' => ['S', 'SCI', 'LAB'],
            'Engineering' => ['E', 'ENG', 'TECH'],
            'Business' => ['B', 'BIZ', 'COM'],
