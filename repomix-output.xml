                            <div class="flex items-center justify-between">
                                <span class="text-sm">Targeting</span>
                                <span class="text-muted-foreground text-sm">
                                    {{ form.targets.length > 0 ? '✓' : '○' }}
                                </span>
                            </div>
                        </div>
                    </CardContent>
                </Card>
            </div>
        </div>

        <!-- Preview Modal -->
        <FormPreviewModal
            v-model:open="showPreview"
