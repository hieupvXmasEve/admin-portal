        id: number;
        name: string;
        email: string;
    };
    created_by_admin?: {
        id: number;
        name: string;
        email: string;
    };
}

interface Statistics {
    registered_count: number;
    checked_in_count: number;
    completed_count: number;
    cancelled_count: number;
    total_gold_distributed: number;
    participation_rate: number | null;
}

interface Student {
    id: number;
    student_id: string;
    full_name: string;
    email: string;
    phone: string | null;
    program: {
        id: number;
        name: string;
        code: string;
    } | null;
    specialization: {
        id: number;
        name: string;
        code: string;
    } | null;
}

interface EventParticipant {
    id: number;
    event_id: number;
    student_id: number;
    status: 'registered' | 'checked_in' | 'completed' | 'cancelled';
    registered_at: string;
    checkin_time: string | null;
    gold_awarded: boolean;
    awarded_at: string | null;
    student: Student;
    checkin_staff: {
        id: number;
        name: string;
        email: string;
