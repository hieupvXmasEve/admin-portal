                        <CardDescription>
                            Cumulative students up to selected semester. Current filter: {{ selectedSemesterLabel }}
                        </CardDescription>
                    </div>
                    <Button variant="outline" :disabled="!filters.selected_semester_id" @click="handleExport">
                        Export Excel
