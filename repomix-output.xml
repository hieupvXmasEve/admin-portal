                    'created_at' => now()->toISOString(),
                ];
            }

            // No recent attendance alerts
            $noRecentAttendanceStudents = $this->getNoRecentAttendanceStudents($lecturer, $filters);
            foreach ($noRecentAttendanceStudents as $student) {
