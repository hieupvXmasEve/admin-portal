            </Button>
            <Button @click="goBackToLectures" variant="outline"> Back to Lecturers </Button>
        </div>
    </div>

    <!-- Alerts -->
    <div v-if="error" class="flex items-center gap-2 rounded-lg border border-red-200 bg-red-50 p-4">
        <AlertCircle class="h-4 w-4 text-red-600" />
