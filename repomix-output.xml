    loadEmailLogs(filters.value)
}

const previousPage = () => {
    if (emailLogs.value.prev_page_url) {
        loadEmailLogs(filters.value, emailLogs.value.current_page - 1)
    }
}

const nextPage = () => {
    if (emailLogs.value.next_page_url) {
