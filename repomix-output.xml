            // Get filter parameters
            $status = $request->get('status');
            $role = $request->get('role');
            $perPage = min((int) $request->get('per_page', 15), 50);

            // Build query
            $query = $club->members()
                ->with(['student', 'approver'])
                ->orderBy('status')
                ->orderBy('role')
                ->orderBy('joined_at', 'desc');

