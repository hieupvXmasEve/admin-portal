            'title' => [
                $isUpdate ? 'sometimes' : 'required',
                'string',
                'max:255',
            ],
            'content' => [
                $isUpdate ? 'sometimes' : 'required',
                'string',
                'max:2000',
            ],
            'is_private' => [
                'sometimes',
                'boolean',
            ],
            'is_alert' => [
                'sometimes',
                'boolean',
            ],
            'priority' => [
                'sometimes',
                'string',
                'in:low,medium,high,urgent',
            ],
        ];
    }

