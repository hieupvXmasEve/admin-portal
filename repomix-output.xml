     * Get status display text
     */
    protected function getStatusDisplay(string $status): string
    {
        return match ($status) {
            'registered' => 'Registered',
            'pending' => 'Pending',
            'waitlisted' => 'Waitlisted',
            'dropped' => 'Dropped',
            'completed' => 'Completed',
            'failed' => 'Failed',
            default => ucfirst($status),
        };
