    code: '',
    name: '',
    description: '',
    grading_type: 'grade' as 'grade' | 'pass_fail',
    prerequisite_module_id: null as number | null,
    units: [] as any[],
});

const onSubmit = (values: any) => {
    Object.assign(inertiaForm, values);

    inertiaForm.post(route('admin.modules.store'), {
