            'completed_credits' => $genEdUnits->whereIn('unit_id', $completedUnitIds)->sum(fn($cu) => $cu->unit->credit_points ?? 0),
            'units' => $genEdUnits->map(function ($curriculumUnit) use ($completedUnitIds) {
